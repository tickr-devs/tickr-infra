#!/usr/bin/python3
"""Writes the bot's credential variables from Secrets Manager into /run/tickr/env (tmpfs, mode
600, owner tickr), in the NAME='value' form the container entrypoint sources, as
~/.config/tickr/env on the Mac. Run as root by tickr-secrets.service before the bot's jobs.

Never prints, logs or passes on a value: messages name a variable at most. Refuses (exit 1,
no file) a secret that is not a JSON object of NAME to string, a name that is not a shell
variable name, and a value the env file cannot quote safely (a single quote, a newline)."""

import json
import os
import pwd
import re
import subprocess
import sys

SECRET_ID = "tickr-bot/env"
TARGET = "/run/tickr/env"
OWNER = "tickr"
NAME = re.compile(r"^[A-Z_][A-Z0-9_]*$")


def fail(message: str) -> None:
    print(f"tickr-secrets: {message}", file=sys.stderr)
    sys.exit(1)


def main() -> None:
    try:
        raw = subprocess.run(
            ["aws", "secretsmanager", "get-secret-value", "--secret-id", SECRET_ID,
             "--query", "SecretString", "--output", "text"],
            capture_output=True, check=True, text=True).stdout
    except subprocess.CalledProcessError as exc:
        # stderr of the CLI never holds the value; keep only its first line.
        first = (exc.stderr or "").strip().splitlines()[:1]
        fail(f"secret {SECRET_ID} not read: {' '.join(first) or exc.returncode}")
    try:
        values = json.loads(raw)
    except ValueError:
        fail(f"secret {SECRET_ID} is not JSON")
    if not isinstance(values, dict) or not values:
        fail(f"secret {SECRET_ID} is not a non-empty JSON object")
    lines = []
    for name, value in sorted(values.items()):
        if not isinstance(name, str) or not NAME.match(name):
            fail("a variable name is not of the form A-Z, 0-9, _")
        if not isinstance(value, str) or "'" in value or "\n" in value or not value:
            fail(f"{name}: value must be a non-empty string without ' or newline")
        lines.append(f"{name}='{value}'\n")
    user = pwd.getpwnam(OWNER)
    # The folder stays root's (others may only pass through); only the file is the owner's.
    folder = os.path.dirname(TARGET)
    os.makedirs(folder, mode=0o711, exist_ok=True)
    os.chown(folder, 0, 0)
    os.chmod(folder, 0o711)
    temp = TARGET + ".new"
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.writelines(lines)
    os.chown(temp, user.pw_uid, user.pw_gid)
    os.replace(temp, TARGET)
    print(f"tickr-secrets: {len(lines)} variables written")


if __name__ == "__main__":
    main()
