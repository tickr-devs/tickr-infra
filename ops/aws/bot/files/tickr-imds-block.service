# The bot's containers use host networking (ops/docker/compose.yaml), so the metadata hop limit
# does not keep them from the server role. This rule refuses the metadata address to the tickr
# account (the containers' user, uid = service_uid), so only root's host units reach the role:
# tickr-secrets, tickr-heartbeat and tickr-image-pull. Amazon Time Sync (169.254.169.123) is a
# different address and stays open. Re-applied at every boot, before Docker starts the API.
[Unit]
Description=Tickr: the service account may not reach the instance metadata (server role)
Before=docker.service
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/srv/tickr/etc/uid.env
ExecStart=/bin/sh -c 'iptables -C OUTPUT -d 169.254.169.254 -m owner --uid-owner "$TICKR_SERVICE_UID" -j REJECT 2>/dev/null || iptables -I OUTPUT -d 169.254.169.254 -m owner --uid-owner "$TICKR_SERVICE_UID" -j REJECT'

[Install]
WantedBy=multi-user.target
