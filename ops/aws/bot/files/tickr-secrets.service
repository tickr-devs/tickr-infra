[Unit]
Description=Tickr: bot credentials from Secrets Manager into /run/tickr/env (memory only)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/srv/tickr/etc/aws.env
RemainAfterExit=yes
ExecStart=/usr/local/bin/tickr-secrets
# /run is tmpfs: the file is gone at shutdown and never reaches the disk or its snapshots.

[Install]
WantedBy=multi-user.target
