#!/bin/sh
# One CloudWatch data point a minute while this server and its local API answer. The alarm
# tickr-bot-heartbeat (main.tf) mails the owner when the points stop: the server is down,
# hung or cut off, which the bot's own watchdog on this same server cannot report.
# TICKR_API_PORT comes from /srv/tickr/etc/ports.env (rendered from config/bot.toml [api] port).
set -eu
curl -fsS -o /dev/null --max-time 10 "http://127.0.0.1:$TICKR_API_PORT/"
aws cloudwatch put-metric-data --namespace Tickr/Bot --metric-name Heartbeat --value 1
